{
  "name": "totalmix-ufx-streamdeck",
  "version": "1.0.0",
  "description": "Elgato Stream Deck + plugin for controlling RME TotalMix FX via OSC",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Edvin Landvik",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fikarn/StreamDeckxRME.git"
  },
  "bugs": {
    "url": "https://github.com/Fikarn/StreamDeckxRME/issues"
  },
  "homepage": "https://github.com/Fikarn/StreamDeckxRME#readme",
  "keywords": [
    "stream-deck",
    "elgato",
    "rme",
    "totalmix",
    "osc",
    "audio",
    "mixer"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "link": "streamdeck link com.edvinlandvik.totalmix-ufx.sdPlugin",
    "restart": "streamdeck restart com.edvinlandvik.totalmix-ufx",
    "icons": "npx tsx scripts/generate-icons.ts"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.0.0",
    "node-osc": "^9.1.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.3.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^20.0.0",
    "@types/node-osc": "^6.0.3",
    "@types/sharp": "^0.31.1",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "rollup": "^4.28.0",
    "sharp": "^0.34.5",
    "tslib": "^2.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
